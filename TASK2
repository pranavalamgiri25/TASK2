    "import requests\n",
    "\n",
    "def scan_website(url):\n",
    "    print(f\"Scanning {url}...\\n\")\n",
    "    report = []\n",
    "    \n",
    "    try:\n",
    "        response = requests.get(url, timeout=5)\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        print(f\"Error connecting to target: {e}\")\n",
    "        return\n",
    "\n",
    "    # 1. Check for exposed server versions / outdated hints\n",
    "    server_header = response.headers.get(\"Server\")\n",
    "    if server_header:\n",
    "        report.append(f\"[INFO] Server banner detected: {server_header} (May reveal software version)\")\n",
    "    else:\n",
    "        report.append(\"[SECURE] Server header is hidden.\")\n",
    "\n",
    "    # 2. Check for common missing security headers (weak configuration)\n",
    "    recommended_headers = [\n",
    "        \"Strict-Transport-Security\",\n",
    "        \"X-Content-Type-Options\",\n",
    "        \"X-Frame-Options\",\n",
    "        \"Content-Security-Policy\"\n",
    "    ]\n",
    "\n",
    "    for header in recommended_headers:\n",
    "        if header not in response.headers:\n",
    "            report.append(f\"[WARN] Missing security header: {header}\")\n",
    "        else:\n",
    "            report.append(f\"[PASS] {header} is present.\")\n",
    "\n",
    "    # 3. Generate a simple vulnerability report\n",
    "    print(\"\\n--- Scan Results ---\")\n",
    "    for item in report:\n",
    "        print(item)\n",
    "\n",
    "    with open(\"vulnerability_report.txt\", \"w\") as f:\n",
    "        f.write(f\"Vulnerability Report for {url}\\n\")\n",
    "        f.write(\"=\" * 40 + \"\\n\")\n",
    "        f.write(\"\\n\".join(report))\n",
    "\n",
    "    print(\"\\nReport saved to 'vulnerability_report.txt'\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    target = input(\"Enter target URL (e.g., http://scanme.nmap.org or http://localhost:8000): \")\n",
    "    scan_website(target)"
   ]
